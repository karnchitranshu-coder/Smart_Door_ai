# =============================================================================
# Smart Door AI — Backend Environment Configuration (.env)
# =============================================================================

DEBUG=1
SECRET_KEY=smartdoor-dev-secret-key-change-in-production-9f8e7d6c5b4a3210
ALLOWED_HOSTS=*

# ---- Admin Dashboard Credentials (created by `python manage.py seed`) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ---- Supabase Database Configuration ----
# 1. Primary (Recommended): Supabase PostgreSQL Connection String
#    Get this from: Supabase Dashboard -> Connect -> Transaction Pooler (port 6543) or Session Pooler (port 5432)
#    Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Automatically fall back to local SQLite (db.sqlite3) if DATABASE_URL is empty or unreachable
SUPABASE_FALLBACK_SQLITE=1

# 2. Optional: Supabase REST API Sync (PostgREST)
#    When running on local SQLite, setting SUPABASE_URL and SUPABASE_KEY will mirror
#    enrolled users, face embeddings, and access logs to your Supabase project tables.
SUPABASE_URL=
SUPABASE_KEY=

# ---- AI Face Recognition Pipeline ----
# "auto"        -> Uses InsightFace (RetinaFace + ArcFace) if installed, otherwise OpenCV real computer-vision
# "insightface" -> Forces InsightFace 512-d ArcFace embeddings
# "opencv"      -> Uses OpenCV Haar/CLAHE/HOG/DCT 512-d facial recognition + eye/motion liveness
# "mock"        -> Synthetic embeddings for unit tests only
AI_BACKEND=auto
ALLOW_MOCK_RECOGNITION=0

# ---- IoT Door Lock Controller ----
# "demo"   -> Software virtual lock with auto-relock countdown
# "serial" -> USB Serial (PySerial) to ESP32 Servo Lock (UNLOCK:<sec> / LOCK)
# "real"   -> MQTT (Mosquitto) to ESP32
IOT_MODE=demo
SERIAL_PORT=COM3
SERIAL_BAUD=115200
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_DEVICE_ID=door01
DEVICE_API_KEY=esp32-shared-secret

# ---- CORS & Camera ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_VERCEL=1
CAMERA_SOURCE=0
